{
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "snapshot_id": {
      "pattern": "^review-[a-f0-9]{64}$",
      "title": "Snapshot Id",
      "type": "string"
    },
    "target_id": {
      "pattern": "^[a-z0-9][a-z0-9_-]{0,99}$",
      "title": "Target Id",
      "type": "string"
    },
    "target_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Target Sha256",
      "type": "string"
    },
    "expected_sequence": {
      "minimum": 0,
      "title": "Expected Sequence",
      "type": "integer"
    },
    "disposition": {
      "enum": [
        "acknowledged",
        "changes_requested",
        "reopened"
      ],
      "title": "Disposition",
      "type": "string"
    },
    "reviewer_label": {
      "maxLength": 120,
      "minLength": 1,
      "title": "Reviewer Label",
      "type": "string"
    },
    "reason": {
      "maxLength": 1600,
      "minLength": 1,
      "title": "Reason",
      "type": "string"
    },
    "note_ids": {
      "items": {
        "type": "string"
      },
      "maxItems": 10,
      "title": "Note Ids",
      "type": "array"
    },
    "correction_ids": {
      "items": {
        "type": "string"
      },
      "maxItems": 5,
      "title": "Correction Ids",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "snapshot_id",
    "target_id",
    "target_sha256",
    "expected_sequence",
    "disposition",
    "reviewer_label",
    "reason",
    "note_ids",
    "correction_ids"
  ],
  "title": "DecisionRequest",
  "type": "object"
}
