{
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "kind": {
      "const": "keystone.review-decision",
      "title": "Kind",
      "type": "string"
    },
    "id": {
      "pattern": "^decision-[a-f0-9]{32}$",
      "title": "Id",
      "type": "string"
    },
    "sequence": {
      "minimum": 1,
      "title": "Sequence",
      "type": "integer"
    },
    "snapshot_id": {
      "pattern": "^review-[a-f0-9]{64}$",
      "title": "Snapshot Id",
      "type": "string"
    },
    "target_id": {
      "pattern": "^[a-z0-9][a-z0-9_-]{0,99}$",
      "title": "Target Id",
      "type": "string"
    },
    "target_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Target Sha256",
      "type": "string"
    },
    "disposition": {
      "enum": [
        "acknowledged",
        "changes_requested",
        "reopened"
      ],
      "title": "Disposition",
      "type": "string"
    },
    "reviewer_label": {
      "maxLength": 120,
      "minLength": 1,
      "title": "Reviewer Label",
      "type": "string"
    },
    "identity_assurance": {
      "const": "local_operator_unverified",
      "title": "Identity Assurance",
      "type": "string"
    },
    "reason": {
      "maxLength": 1600,
      "minLength": 1,
      "title": "Reason",
      "type": "string"
    },
    "recorded_at": {
      "maxLength": 80,
      "minLength": 1,
      "title": "Recorded At",
      "type": "string"
    },
    "financial_approval": {
      "const": false,
      "title": "Financial Approval",
      "type": "boolean"
    }
  },
  "required": [
    "schema_version",
    "kind",
    "id",
    "sequence",
    "snapshot_id",
    "target_id",
    "target_sha256",
    "disposition",
    "reviewer_label",
    "identity_assurance",
    "reason",
    "recorded_at",
    "financial_approval"
  ],
  "title": "Decision",
  "type": "object"
}
