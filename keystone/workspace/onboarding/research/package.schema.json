{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:keystone:financial-kit-package:2",
  "title": "Prospective financial-kit package, envelope 2 / payload 1",
  "$comment": "Runtime structural contract. Semantic, permission, identity, financial and durable execution checks are required separately; shape validity grants no approval.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "workflow",
    "payload_format",
    "dataset",
    "sources",
    "payload"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "kind": {
      "const": "keystone.input-package"
    },
    "workflow": {
      "const": "research"
    },
    "payload_format": {
      "const": "agent1.financial-kit/1"
    },
    "dataset": {
      "$ref": "#/$defs/dataset"
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      },
      "minItems": 1,
      "maxItems": 20
    },
    "payload": {
      "$ref": "#/$defs/kit"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,79}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "date": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "instant": {
      "type": "string",
      "format": "date-time",
      "maxLength": 80,
      "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "decimal": {
      "type": "string",
      "maxLength": 23,
      "pattern": "^(?!-0(?:\\.0+)?$)-?(?:0|[1-9][0-9]{0,14})(?:\\.[0-9]{1,6})?$"
    },
    "listing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ticker",
        "exchange",
        "quote_currency",
        "share_class"
      ],
      "properties": {
        "ticker": {
          "type": "string",
          "pattern": "^[A-Z0-9][A-Z0-9.^=-]{0,31}$"
        },
        "exchange": {
          "type": "string",
          "pattern": "^[A-Z0-9]{4}$"
        },
        "quote_currency": {
          "const": "EUR"
        },
        "share_class": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "source_id",
        "locator",
        "missing_reason"
      ],
      "properties": {
        "value": {
          "anyOf": [
            {
              "$ref": "#/$defs/decimal"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "locator": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            },
            {
              "type": "null"
            }
          ]
        },
        "missing_reason": {
          "enum": [
            null,
            "not_provided",
            "not_disclosed"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "value": {
                "type": "null"
              }
            }
          },
          "then": {
            "properties": {
              "source_id": {
                "const": null
              },
              "locator": {
                "const": null
              },
              "missing_reason": {
                "enum": [
                  "not_provided",
                  "not_disclosed"
                ]
              }
            }
          },
          "else": {
            "properties": {
              "source_id": {
                "$ref": "#/$defs/id"
              },
              "locator": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240
              },
              "missing_reason": {
                "const": null
              }
            }
          }
        }
      ]
    },
    "period": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "period_start",
        "period_end",
        "currency",
        "monetary_unit",
        "capex_convention",
        "working_capital_convention",
        "debt_basis",
        "cash_basis",
        "observations"
      ],
      "properties": {
        "period_start": {
          "$ref": "#/$defs/date"
        },
        "period_end": {
          "$ref": "#/$defs/date"
        },
        "currency": {
          "const": "EUR"
        },
        "monetary_unit": {
          "const": "base"
        },
        "capex_convention": {
          "const": "outflow_magnitude"
        },
        "working_capital_convention": {
          "const": "balance_change"
        },
        "debt_basis": {
          "const": "interest_bearing_including_leases"
        },
        "cash_basis": {
          "const": "unrestricted_cash_and_equivalents"
        },
        "observations": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "revenue",
            "gross_profit",
            "operating_income",
            "net_income",
            "pretax_income",
            "tax_provision",
            "depreciation_amortization",
            "capex",
            "change_in_working_capital",
            "total_debt",
            "cash_and_equivalents",
            "noncontrolling_interests",
            "preferred_equity",
            "other_equity_claims"
          ],
          "properties": {
            "revenue": {
              "$ref": "#/$defs/observation"
            },
            "gross_profit": {
              "$ref": "#/$defs/observation"
            },
            "operating_income": {
              "$ref": "#/$defs/observation"
            },
            "net_income": {
              "$ref": "#/$defs/observation"
            },
            "pretax_income": {
              "$ref": "#/$defs/observation"
            },
            "tax_provision": {
              "$ref": "#/$defs/observation"
            },
            "depreciation_amortization": {
              "$ref": "#/$defs/observation"
            },
            "capex": {
              "$ref": "#/$defs/observation"
            },
            "change_in_working_capital": {
              "$ref": "#/$defs/observation"
            },
            "total_debt": {
              "$ref": "#/$defs/observation"
            },
            "cash_and_equivalents": {
              "$ref": "#/$defs/observation"
            },
            "noncontrolling_interests": {
              "$ref": "#/$defs/observation"
            },
            "preferred_equity": {
              "$ref": "#/$defs/observation"
            },
            "other_equity_claims": {
              "$ref": "#/$defs/observation"
            }
          }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "role",
        "category",
        "provider_or_owner",
        "reference",
        "period_start",
        "period_end",
        "published_at",
        "retrieved_at",
        "currency",
        "units",
        "permission_record_id"
      ],
      "properties": {
        "source_id": {
          "$ref": "#/$defs/id"
        },
        "role": {
          "enum": [
            "annual_statements",
            "quote_snapshot"
          ]
        },
        "category": {
          "enum": [
            "synthetic",
            "public_provider",
            "issuer",
            "confidential"
          ]
        },
        "provider_or_owner": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "reference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "period_start": {
          "$ref": "#/$defs/date"
        },
        "period_end": {
          "$ref": "#/$defs/date"
        },
        "published_at": {
          "anyOf": [
            {
              "$ref": "#/$defs/instant"
            },
            {
              "type": "null"
            }
          ]
        },
        "retrieved_at": {
          "anyOf": [
            {
              "$ref": "#/$defs/instant"
            },
            {
              "type": "null"
            }
          ]
        },
        "currency": {
          "const": "EUR"
        },
        "units": {
          "const": "base"
        },
        "permission_record_id": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "quote": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "listing",
        "monetary_unit",
        "share_basis",
        "as_of",
        "observations"
      ],
      "properties": {
        "listing": {
          "$ref": "#/$defs/listing"
        },
        "monetary_unit": {
          "const": "base"
        },
        "share_basis": {
          "const": "ordinary_shares"
        },
        "as_of": {
          "$ref": "#/$defs/date"
        },
        "observations": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "current_price",
            "market_cap",
            "shares_outstanding"
          ],
          "properties": {
            "current_price": {
              "$ref": "#/$defs/observation"
            },
            "market_cap": {
              "$ref": "#/$defs/observation"
            },
            "shares_outstanding": {
              "$ref": "#/$defs/observation"
            }
          }
        }
      }
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "entity_id",
        "listing",
        "upstream_id",
        "supersedes_version_id"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "entity_id": {
          "$ref": "#/$defs/id"
        },
        "listing": {
          "$ref": "#/$defs/listing"
        },
        "upstream_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            {
              "type": "null"
            }
          ]
        },
        "supersedes_version_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "kit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "kind",
        "entity_id",
        "listing",
        "company_type",
        "instrument_type",
        "financial_scope",
        "currency",
        "monetary_unit",
        "period_type",
        "periods",
        "quote"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "kind": {
          "const": "keystone.financial-kit"
        },
        "entity_id": {
          "$ref": "#/$defs/id"
        },
        "listing": {
          "$ref": "#/$defs/listing"
        },
        "company_type": {
          "const": "nonfinancial_operating"
        },
        "instrument_type": {
          "const": "ordinary_equity"
        },
        "financial_scope": {
          "const": "consolidated"
        },
        "currency": {
          "const": "EUR"
        },
        "monetary_unit": {
          "const": "base"
        },
        "period_type": {
          "const": "annual"
        },
        "periods": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/period"
          },
          "minItems": 1,
          "maxItems": 10
        },
        "quote": {
          "anyOf": [
            {
              "$ref": "#/$defs/quote"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
