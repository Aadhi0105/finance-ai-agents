{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:keystone:local-research-result:1",
  "title": "Prospective local analytical evidence v1",
  "$comment": "Runtime structural contract. Semantic, permission, identity, financial and durable execution checks are required separately; shape validity grants no approval.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "source_schema",
    "result_id",
    "identity",
    "execution",
    "provenance",
    "lineage",
    "analysis_plan",
    "evidence_gate",
    "sections",
    "metrics",
    "series",
    "derivations",
    "checks"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "keystone.local-research-result"
    },
    "source_schema": {
      "const": "agent1.local-analysis/1"
    },
    "result_id": {
      "type": "string",
      "pattern": "^result-[a-f0-9]{32}$"
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entity_id",
        "listing",
        "currency",
        "monetary_unit",
        "period_start",
        "period_end"
      ],
      "properties": {
        "entity_id": {
          "$ref": "#/$defs/id"
        },
        "listing": {
          "$ref": "#/$defs/listing"
        },
        "currency": {
          "const": "EUR"
        },
        "monetary_unit": {
          "const": "base"
        },
        "period_start": {
          "$ref": "#/$defs/date"
        },
        "period_end": {
          "$ref": "#/$defs/date"
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "status",
        "profile",
        "profile_version",
        "evaluated_on",
        "financial_approval",
        "live_data_enabled",
        "paid_models_enabled",
        "provider_requests",
        "model_calls",
        "output_tokens"
      ],
      "properties": {
        "mode": {
          "const": "local_inputs"
        },
        "status": {
          "const": "completed"
        },
        "profile": {
          "const": "calculate-local-research"
        },
        "profile_version": {
          "const": 1
        },
        "evaluated_on": {
          "$ref": "#/$defs/date"
        },
        "financial_approval": {
          "const": false
        },
        "live_data_enabled": {
          "const": false
        },
        "paid_models_enabled": {
          "const": false
        },
        "provider_requests": {
          "const": 0
        },
        "model_calls": {
          "const": 0
        },
        "output_tokens": {
          "const": 0
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "classification",
        "source_integrity",
        "source_authenticity",
        "producer"
      ],
      "properties": {
        "classification": {
          "enum": [
            "synthetic",
            "provider",
            "issuer",
            "internal",
            "mixed"
          ]
        },
        "source_integrity": {
          "const": "matched"
        },
        "source_authenticity": {
          "const": "not_independently_verified"
        },
        "producer": {
          "$ref": "#/$defs/producer"
        }
      }
    },
    "lineage": {
      "$ref": "#/$defs/lineage"
    },
    "analysis_plan": {
      "$ref": "#/$defs/analysis_plan"
    },
    "evidence_gate": {
      "const": "review_required"
    },
    "sections": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/section"
      },
      "minItems": 8,
      "maxItems": 8
    },
    "metrics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/metric"
      },
      "minItems": 1,
      "maxItems": 200
    },
    "series": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/series"
      },
      "minItems": 0,
      "maxItems": 10
    },
    "derivations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/derivation"
      },
      "minItems": 1,
      "maxItems": 200
    },
    "checks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/check"
      },
      "minItems": 1,
      "maxItems": 100
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,79}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "date": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "result_decimal": {
      "type": "string",
      "maxLength": 80,
      "pattern": "^-?(?:0|[1-9][0-9]{0,39})(?:\\.[0-9]{1,30})?$"
    },
    "listing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ticker",
        "exchange",
        "quote_currency",
        "share_class"
      ],
      "properties": {
        "ticker": {
          "type": "string",
          "pattern": "^[A-Z0-9][A-Z0-9.^=-]{0,31}$"
        },
        "exchange": {
          "type": "string",
          "pattern": "^[A-Z0-9]{4}$"
        },
        "quote_currency": {
          "const": "EUR"
        },
        "share_class": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        }
      }
    },
    "rate": {
      "type": "string",
      "maxLength": 12,
      "pattern": "^-?(?:0|1)(?:\\.[0-9]{1,6})?$"
    },
    "valuation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "horizon_years",
        "discount_rate",
        "terminal_growth",
        "high_growth",
        "scenario_deltas",
        "weights",
        "tax_basis",
        "tax_rate",
        "rationale"
      ],
      "properties": {
        "method": {
          "const": "fcff-linear-fade/1"
        },
        "horizon_years": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        },
        "discount_rate": {
          "$ref": "#/$defs/rate"
        },
        "terminal_growth": {
          "$ref": "#/$defs/rate"
        },
        "high_growth": {
          "$ref": "#/$defs/rate"
        },
        "scenario_deltas": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "bear",
            "base",
            "bull"
          ],
          "properties": {
            "bear": {
              "const": "-0.04"
            },
            "base": {
              "const": "0"
            },
            "bull": {
              "const": "0.04"
            }
          }
        },
        "weights": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "bear",
            "base",
            "bull"
          ],
          "properties": {
            "bear": {
              "$ref": "#/$defs/rate"
            },
            "base": {
              "$ref": "#/$defs/rate"
            },
            "bull": {
              "$ref": "#/$defs/rate"
            }
          }
        },
        "tax_basis": {
          "enum": [
            "explicit_rate",
            "effective_rate"
          ]
        },
        "tax_rate": {
          "anyOf": [
            {
              "$ref": "#/$defs/rate"
            },
            {
              "type": "null"
            }
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "tax_basis": {
                "const": "explicit_rate"
              }
            }
          },
          "then": {
            "properties": {
              "tax_rate": {
                "$ref": "#/$defs/rate"
              }
            }
          },
          "else": {
            "properties": {
              "tax_rate": {
                "const": null
              }
            }
          }
        }
      ]
    },
    "analysis_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "financial_summary",
        "annual_trends",
        "quote_metrics",
        "valuation"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "financial_summary": {
          "const": true
        },
        "annual_trends": {
          "const": true
        },
        "quote_metrics": {
          "const": "if_eligible"
        },
        "valuation": {
          "anyOf": [
            {
              "$ref": "#/$defs/valuation"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workspace_id",
        "dataset_id",
        "version_id",
        "job_id",
        "operation_id",
        "request_sha256",
        "contract_sha256",
        "payload_sha256",
        "receipt_sha256",
        "entity_sha256",
        "policy_sha256",
        "analysis_plan_sha256",
        "source_reference_sha256",
        "assumption_review_sha256"
      ],
      "properties": {
        "workspace_id": {
          "$ref": "#/$defs/id"
        },
        "dataset_id": {
          "$ref": "#/$defs/id"
        },
        "version_id": {
          "$ref": "#/$defs/id"
        },
        "job_id": {
          "type": "string",
          "pattern": "^job-[a-f0-9]{32}$"
        },
        "operation_id": {
          "type": "string",
          "pattern": "^web-[a-f0-9]{32}$"
        },
        "request_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "contract_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "payload_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "receipt_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "entity_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "policy_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "analysis_plan_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "source_reference_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "assumption_review_sha256": {
          "anyOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code_commit",
        "code_worktree_dirty",
        "python",
        "dependency_lock_sha256",
        "source_tree_sha256",
        "validator_version",
        "recipe"
      ],
      "properties": {
        "code_commit": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{40}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "code_worktree_dirty": {
          "type": "boolean"
        },
        "python": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "dependency_lock_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "source_tree_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "validator_version": {
          "const": "financial-kit/1.0.0"
        },
        "recipe": {
          "const": "agent1-local-report/1.0.0"
        }
      }
    },
    "reason": {
      "enum": [
        "missing_observation",
        "nonpositive_revenue",
        "nonpositive_earnings",
        "nonpositive_operating_income",
        "history_gap",
        "insufficient_history",
        "stale_quote",
        "missing_quote",
        "missing_fcff_input",
        "tax_basis_unavailable",
        "nonpositive_fcff",
        "bridge_incomplete",
        "unsupported_equity_claims",
        "missing_shares",
        "distressed_equity",
        "excluded_by_plan",
        "unsupported_input_group",
        "source_dates_unknown",
        "stale_statements",
        "operator_attested_origin",
        "synthetic_evidence",
        "assumptions_require_review",
        "calculation_failed"
      ]
    },
    "reason_list": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/reason"
      },
      "minItems": 0,
      "maxItems": 20,
      "uniqueItems": true
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "value",
        "unit",
        "currency",
        "period_end",
        "as_of",
        "visibility",
        "availability",
        "reason_codes",
        "derivation_id"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "value": {
          "anyOf": [
            {
              "$ref": "#/$defs/result_decimal"
            },
            {
              "type": "null"
            }
          ]
        },
        "unit": {
          "enum": [
            "currency",
            "currency_per_share",
            "fraction",
            "multiple",
            "count"
          ]
        },
        "currency": {
          "enum": [
            "EUR",
            null
          ]
        },
        "period_end": {
          "anyOf": [
            {
              "$ref": "#/$defs/date"
            },
            {
              "type": "null"
            }
          ]
        },
        "as_of": {
          "anyOf": [
            {
              "$ref": "#/$defs/date"
            },
            {
              "type": "null"
            }
          ]
        },
        "visibility": {
          "enum": [
            "main",
            "supporting",
            "diagnostic"
          ]
        },
        "availability": {
          "enum": [
            "available",
            "unavailable",
            "withheld",
            "not_applicable"
          ]
        },
        "reason_codes": {
          "$ref": "#/$defs/reason_list"
        },
        "derivation_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "availability": {
                "const": "available"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "$ref": "#/$defs/result_decimal"
              },
              "derivation_id": {
                "$ref": "#/$defs/id"
              }
            }
          },
          "else": {
            "properties": {
              "value": {
                "const": null
              },
              "derivation_id": {
                "const": null
              },
              "reason_codes": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "requested",
        "availability",
        "reason_codes",
        "metric_ids"
      ],
      "properties": {
        "id": {
          "enum": [
            "summary",
            "performance",
            "valuation",
            "peers",
            "market",
            "consensus",
            "external-research",
            "evidence"
          ]
        },
        "requested": {
          "type": "boolean"
        },
        "availability": {
          "enum": [
            "available",
            "unavailable",
            "withheld",
            "not_applicable"
          ]
        },
        "reason_codes": {
          "$ref": "#/$defs/reason_list"
        },
        "metric_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "minItems": 0,
          "maxItems": 200
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "availability": {
                "enum": [
                  "unavailable",
                  "withheld",
                  "not_applicable"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "reason_codes": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "date",
        "value",
        "metric_id",
        "reason_codes"
      ],
      "properties": {
        "date": {
          "$ref": "#/$defs/date"
        },
        "value": {
          "anyOf": [
            {
              "$ref": "#/$defs/result_decimal"
            },
            {
              "type": "null"
            }
          ]
        },
        "metric_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "reason_codes": {
          "$ref": "#/$defs/reason_list"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "value": {
                "type": "null"
              }
            }
          },
          "then": {
            "properties": {
              "metric_id": {
                "const": null
              },
              "reason_codes": {
                "minItems": 1
              }
            }
          },
          "else": {
            "properties": {
              "metric_id": {
                "$ref": "#/$defs/id"
              }
            }
          }
        }
      ]
    },
    "series": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "kind",
        "unit",
        "currency",
        "points"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "kind": {
          "enum": [
            "bar",
            "line"
          ]
        },
        "unit": {
          "enum": [
            "currency",
            "fraction"
          ]
        },
        "currency": {
          "enum": [
            "EUR",
            null
          ]
        },
        "points": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/point"
          },
          "minItems": 1,
          "maxItems": 10
        }
      }
    },
    "derivation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "method",
        "input_pointers",
        "parameter_pointers",
        "metric_ids",
        "rounding"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "method": {
          "enum": [
            "sourced_annual",
            "gross_margin",
            "operating_margin",
            "net_margin",
            "revenue_yoy",
            "revenue_cagr",
            "annual_pe",
            "ev_operating_income",
            "fcff",
            "dcf_scenario",
            "dcf_weighted",
            "model_value_gap"
          ]
        },
        "input_pointers": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^/",
            "maxLength": 240
          },
          "minItems": 1,
          "maxItems": 200
        },
        "parameter_pointers": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^/analysis_plan/",
            "maxLength": 240
          },
          "minItems": 0,
          "maxItems": 40
        },
        "metric_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "minItems": 1,
          "maxItems": 200
        },
        "rounding": {
          "enum": [
            "source_decimal",
            "engine_ratio_4dp",
            "engine_amount_0dp",
            "engine_per_share_2dp",
            "engine_fraction_4dp",
            "engine_float_decimal"
          ]
        }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "reason_code",
        "section_ids",
        "detail"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "status": {
          "enum": [
            "pass",
            "review",
            "hold"
          ]
        },
        "reason_code": {
          "$ref": "#/$defs/reason"
        },
        "section_ids": {
          "type": "array",
          "items": {
            "enum": [
              "summary",
              "performance",
              "valuation",
              "peers",
              "market",
              "consensus",
              "external-research",
              "evidence"
            ]
          },
          "minItems": 1,
          "maxItems": 8
        },
        "detail": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      }
    }
  }
}
