{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:keystone:design:financial-kit-validation:3",
  "title": "Prospective accepted financial-kit validation receipt v3",
  "$comment": "4A.2 prospective design only. Structural validity is not runtime acceptance, source permission or financial approval.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "validator_version",
    "producer",
    "payload_sha256",
    "upstream_id",
    "period_start",
    "period_end",
    "validation_status",
    "analytical_execution",
    "eligible",
    "evaluated_on",
    "listing_scope",
    "reason_codes",
    "sections"
  ],
  "properties": {
    "schema_version": {
      "const": 3
    },
    "kind": {
      "const": "keystone.financial-kit-validation"
    },
    "validator_version": {
      "const": "financial-kit/1.0.0"
    },
    "producer": {
      "$ref": "#/$defs/producer"
    },
    "payload_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "upstream_id": {
      "const": null
    },
    "period_start": {
      "$ref": "#/$defs/date"
    },
    "period_end": {
      "$ref": "#/$defs/date"
    },
    "validation_status": {
      "const": "validated"
    },
    "analytical_execution": {
      "const": "not_started"
    },
    "eligible": {
      "const": true
    },
    "evaluated_on": {
      "$ref": "#/$defs/date"
    },
    "listing_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "first_version_id",
        "scope_sha256"
      ],
      "properties": {
        "first_version_id": {
          "$ref": "#/$defs/id"
        },
        "scope_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "reason_codes": {
      "$ref": "#/$defs/reason_list"
    },
    "sections": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/section"
      },
      "minItems": 8,
      "maxItems": 8
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,79}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "date": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "reason": {
      "enum": [
        "missing_observation",
        "nonpositive_revenue",
        "nonpositive_earnings",
        "nonpositive_operating_income",
        "history_gap",
        "insufficient_history",
        "stale_quote",
        "missing_quote",
        "missing_fcff_input",
        "tax_basis_unavailable",
        "nonpositive_fcff",
        "bridge_incomplete",
        "unsupported_equity_claims",
        "missing_shares",
        "distressed_equity",
        "excluded_by_plan",
        "unsupported_input_group",
        "source_dates_unknown",
        "stale_statements",
        "operator_attested_origin",
        "synthetic_evidence",
        "assumptions_require_review",
        "calculation_failed"
      ]
    },
    "reason_list": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/reason"
      },
      "minItems": 0,
      "maxItems": 20,
      "uniqueItems": true
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code_commit",
        "code_worktree_dirty",
        "python",
        "dependency_lock_sha256",
        "source_tree_sha256"
      ],
      "properties": {
        "code_commit": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{40}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "code_worktree_dirty": {
          "type": "boolean"
        },
        "python": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "dependency_lock_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "source_tree_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "reason_codes"
      ],
      "properties": {
        "id": {
          "enum": [
            "summary",
            "performance",
            "valuation",
            "peers",
            "market",
            "consensus",
            "external-research",
            "evidence"
          ]
        },
        "status": {
          "enum": [
            "minimum_satisfied",
            "inputs_present",
            "inputs_missing",
            "requires_plan",
            "unsupported"
          ]
        },
        "reason_codes": {
          "$ref": "#/$defs/reason_list"
        }
      }
    }
  }
}
